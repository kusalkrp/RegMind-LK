FROM python:3.11-slim

RUN useradd --create-home --shell /bin/bash appuser

WORKDIR /app

# Install system deps for pdfplumber / tesseract
RUN apt-get update && apt-get install -y --no-install-recommends \
    curl \
    tesseract-ocr \
    tesseract-ocr-eng \
    poppler-utils \
    && rm -rf /var/lib/apt/lists/*

# Copy source before editable install so setuptools can resolve the package
COPY pyproject.toml .
COPY src/ ./src/
COPY ingestion/ ./ingestion/
RUN pip install --no-cache-dir -e ".[dev]"

RUN chown -R appuser:appuser /app

USER appuser

EXPOSE 8001

CMD ["python", "-m", "sltda_mcp.mcp_server.main"]
